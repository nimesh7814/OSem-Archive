# =============================================================
# osem_db Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# -------------------------------------------------------------
# PostgreSQL / TimescaleDB
# Host/port as seen FROM THE HOST MACHINE (Python scripts connect here)
# Docker maps POSTGRES_PORT on the host -> 5432 inside the container
# -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=osem_db
POSTGRES_USER=osem_user
POSTGRES_PASSWORD=changeme

# -------------------------------------------------------------
# PostgREST
# -------------------------------------------------------------
POSTGREST_PORT=3000

# -------------------------------------------------------------
# pgAdmin
# -------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme
PGADMIN_PORT=5050

# -------------------------------------------------------------
# Volumes — named Docker volumes (recommended for Windows)
# Change these only if you want custom volume names
# -------------------------------------------------------------
POSTGRES_DATA_DIR=postgres_data
PGADMIN_DATA_DIR=pgadmin_data
