# backend/.env.example
# Copy to .env and fill in real values. Do not commit the real .env file.

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=timescaledb
# Host-exposed port (see docker-compose.yml). 5433 avoids clashing with a
# locally installed PostgreSQL service that may already own 5432 on Windows.
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@timescaledb:5432/DBNAME

# Redis (cache + Celery broker/backend). docker-compose.yml overrides these
# to point at the "redis" service when running the api/export_worker
# containers; set to localhost here for running the API outside Docker.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# pgAdmin (optional, for local DB inspection)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# Archive source
ARCHIVE_BASE_URL=https://archive.opensensemap.org

# Ingest worker date range.
# Supports YYYY-MM-DD, first, latest/present, today, yesterday.
# Empty defaults to first -> latest.
INGEST_DATE_FROM=
INGEST_DATE_TO=

# Object storage (for export downloads)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Export limits
EXPORT_MAX_ROWS=5000000

# App
LOG_LEVEL=INFO
