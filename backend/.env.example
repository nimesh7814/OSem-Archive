# backend/.env.example
# Copy this file to backend/.env and fill the secrets before running Docker Compose.

# Database
POSTGRES_USER=osem
POSTGRES_PASSWORD=change-me
POSTGRES_DB=osem_archive

# Use localhost:5433 when running backend code on the host.
# Docker Compose overrides these to timescaledb:5432 inside containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
MAX_WAIT_TIME_SECONDS=10
DATABASE_URL=postgresql+asyncpg://osem:change-me@timescaledb:5432/osem_archive

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5151

# Redis
# Use localhost when running backend code on the host.
# Docker Compose overrides REDIS_HOST to redis inside API/worker containers.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_CELERY_DB=1
REDIS_TTL_SECONDS=86400
REDIS_OPERATION_TIMEOUT_SECONDS=2

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
EXPORT_QUEUE_TIMEOUT_SECONDS=8

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=sensor-exports
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false
MINIO_TTL_SECONDS=86400
MINIO_CONNECT_TIMEOUT_SECONDS=2
MINIO_READ_TIMEOUT_SECONDS=2

# Object storage compatibility aliases
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=sensor-exports
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=change-me

# Archive source
ARCHIVE_BASE_URL=https://archive.opensensemap.org

# Ingest scheduler
# The scheduler container runs ingest/load_archive.py every day at this time.
INGEST_SCHEDULE_TIME=00:00
INGEST_SCHEDULE_TIMEZONE=Europe/Berlin
INGEST_SCHEDULER_RUN_ON_START=false

# App
LOG_LEVEL=INFO
LOG_FILE=/app/logs/api.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Job settings
JOB_TRY=3
DAYS_LIMIT=1826
EXPORT_EXPIRE_HOURS=24
TTL_HOURS=24
