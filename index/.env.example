# ═══════════════════════════════════════════════════════════════
# OpenSenseMap Indexer — Environment Variables
# ───────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════


# ── PostgreSQL ───────────────────────────────────────────────
# Used by the db service in docker-compose

POSTGRES_DB=opensensemap
POSTGRES_USER=osm_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# Full connection string used by the indexer (asyncpg format)
# Format: postgresql://{user}:{password}@{host}:{port}/{db}
# When running via docker-compose, host = service name "db"
DATABASE_URL=postgresql://osm_user:change_me_in_production@db:5432/opensensemap

# If connecting from outside Docker (e.g. local dev):
# DATABASE_URL=postgresql://osm_user:change_me_in_production@localhost:5432/opensensemap


# ── Archive ──────────────────────────────────────────────────
# Base URL of the OpenSenseMap archive (no trailing slash)
ARCHIVE_BASE_URL=https://archive.opensensemap.org


# ── Crawler behaviour ────────────────────────────────────────
# Number of concurrent HTTP requests to the archive
# Keep low (3-5) to be respectful to the archive server
CRAWL_CONCURRENCY=5

# Timeout in seconds for each HTTP request
REQUEST_TIMEOUT_SECONDS=30


# ── Reverse geocoding (Nominatim) ────────────────────────────
# Nominatim usage policy requires max 1 request per second
# Do not set below 1.1 or your IP may get blocked
GEOCODE_DELAY_SECONDS=1.1
