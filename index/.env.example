# ═══════════════════════════════════════════════════════════════
# OpenSenseMap Indexer — Environment Variables
# ───────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp env.example .env
# ═══════════════════════════════════════════════════════════════


# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=opensensemap
POSTGRES_USER=osm_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# Full connection string used by the indexer (asyncpg format)
# docker-compose: host = service name "db"
DATABASE_URL=postgresql://osm_user:change_me_in_production@db:5432/opensensemap

# Local dev (outside Docker):
# DATABASE_URL=postgresql://osm_user:change_me_in_production@localhost:5432/opensensemap


# ── Archive ──────────────────────────────────────────────────
ARCHIVE_BASE_URL=https://archive.opensensemap.org


# ── Crawler ──────────────────────────────────────────────────
# Keep CRAWL_CONCURRENCY low (3-5) to be respectful to the archive server
CRAWL_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=30


# ── Admin boundaries (in-process geocoding) ──────────────────
GEOCODE_DELAY_SECONDS=1.1


# ── PostgREST ────────────────────────────────────────────────
# The authenticator role is created by postgrest_roles.sql.
# Its password must match the one in that SQL file.
POSTGREST_DB_USER=authenticator
POSTGREST_DB_PASSWORD=change_authenticator_password

# Schema exposed by PostgREST
POSTGREST_DB_SCHEMA=public

# Anonymous role (read-only, no login)
POSTGREST_ANON_ROLE=web_anon

# Host port PostgREST listens on
POSTGREST_PORT=3001

# JWT secret — used to sign/verify tokens for authenticated requests.
# Generate with: openssl rand -base64 32
PGRST_JWT_SECRET=change_this_to_a_random_32_char_secret


# ── pgAdmin ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_pgadmin_password

# Host port pgAdmin listens on
PGADMIN_PORT=5051
