# OpenSenseMap Scraper — environment configuration
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is in .gitignore and must NEVER be committed to version control.

# PostgreSQL / TimescaleDB
DB_HOST=db
DB_PORT=5435
DB_NAME=opensensemap
DB_USER=osm

# Use a long random password — at least 32 characters recommended.
# Generate one with:  openssl rand -base64 32
DB_PASSWORD=password

# pgAdmin 4
PGADMIN_EMAIL=admin@example.com

# Use a different strong password for pgAdmin than for the database.
# Generate one with:  openssl rand -base64 32
PGADMIN_PASSWORD=password

# Port pgAdmin is exposed on the host (default 5050)
PGADMIN_PORT=5050

# Dashboard ports

# Scraper progress monitor — date/station/sensor progress bars + live stats
# Open: http://localhost:5051
MONITOR_PORT=5051

# Interactive station map — Leaflet map with per-sensor reading stats
# Open: http://localhost:5052
MAP_PORT=5052

# Scraper rate-limiting  (all optional — defaults shown)
# Seconds to wait between individual HTTP requests (random in [MIN, MAX])
DELAY_MIN=0.1
DELAY_MAX=0.4

# Extra pause between processing each archive date
DELAY_PER_DATE=0.5

# Base wait in seconds after a 429 response (doubles on each retry)
DELAY_429_BASE=60

# How many times to retry after a 429 before giving up on that date
MAX_429_RETRIES=5
